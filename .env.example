# HomeNetMon configuration. Copy to .env and edit:   cp .env.example .env
#
# Precedence: values saved in the Settings UI (the Configuration table) override
# these for network_range, ping_interval, scan_interval and bandwidth_interval;
# the environment seeds them on a fresh database. Everything else is read from
# here at startup.

# ---------------- Network ----------------
# CIDR range to discover and monitor. Addresses outside it (Docker/libvirt bridges) are ignored.
NETWORK_RANGE=192.168.86.0/24
# Seconds between ping cycles. Deliberately gentle for home IoT devices.
PING_INTERVAL=600
# Seconds between ARP/nmap discovery scans (86400 = daily).
SCAN_INTERVAL=86400
# Seconds between host-interface bandwidth samples.
BANDWIDTH_INTERVAL=300
PING_TIMEOUT=3.0
# Concurrent ping workers per cycle.
MAX_WORKERS=50
# Days of monitoring history to keep (per-table overrides: Settings/API keys *_retention_days).
DATA_RETENTION_DAYS=30
# Devices unseen for this many days stop being pinged until a scan sees them again.
STALE_DEVICE_DAYS=30

# ---------------- Web server ----------------
# 0.0.0.0 so other devices on the LAN can open the dashboard.
HOST=0.0.0.0
PORT=5000
# production|development (FLASK_ENV is accepted as a fallback).
ENV=production
DEBUG=false
# Public URL used in notification links. Default: http://<this host's LAN IP>:<PORT>.
# BASE_URL=http://homenetmon.local:5000
# Set true when served over HTTPS (marks the CSRF cookie Secure).
HTTPS_ENABLED=false

# ---------------- Security ----------------
# Random 32+ char value; signs CSRF tokens and the session cookie.
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE-WITH-OUTPUT-OF-secrets.token_hex(32)
# Allow the Settings page to restart the service via a transient systemd timer.
ALLOW_SERVICE_RESTART=false
# HOMENETMON_SERVICE_UNIT=homenetmon

# ---------------- Database ----------------
# SQLite (recommended). Keep the file out of the checkout. PostgreSQL URLs also work.
DATABASE_URL=sqlite:///production_data/homeNetMon.db

# ---------------- Logging ----------------
LOG_LEVEL=INFO
LOG_FILE=homenetmon.log
LOG_MAX_SIZE=10485760
LOG_BACKUP_COUNT=5

# ---------------- Notifications ----------------
# Push via ntfy (also editable in Settings > Alerts & Notifications)
# NTFY_ENABLED=true
# NTFY_SERVER=https://ntfy.sh
# NTFY_TOPIC=my-homenetmon-alerts
# NTFY_USERNAME=
# NTFY_PASSWORD=
# Email (SMTP credentials live here; sender/recipients can be set in Settings)
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=you@gmail.com
# SMTP_PASSWORD=app-password
# SMTP_USE_TLS=true
# ALERT_FROM_EMAIL=homenetmon@example.com
# ALERT_TO_EMAILS=you@example.com,other@example.com
# Webhook
# WEBHOOK_URL=https://hooks.example/homenetmon
# WEBHOOK_TIMEOUT=10

# ---------------- Optional services ----------------
# nmap port scanning of every device. Off by default: it can destabilise IoT devices.
SECURITY_SCANNING_ENABLED=false
SECURITY_SCAN_INTERVAL=86400
# Rate-limiter backend; falls back to in-memory storage when unreachable.
# REDIS_URL=redis://localhost:6379/0
# Comma-separated IPs exempt from rate limiting (127.0.0.1 always is).
# RATE_LIMIT_TRUSTED_IPS=

# Optional: dnsmasq / Pi-hole leases file used to name devices that never answer DNS or mDNS
# DHCP_LEASES_FILE=/etc/pihole/dhcp.leases

# Internet reachability: external host pinged every WAN_CHECK_INTERVAL seconds (the gateway is detected)
# WAN_CHECK_TARGET=1.1.1.1
# WAN_CHECK_INTERVAL=60

# Security scanner: skip printers (nmap probes can jam some models) and keep the printer-safe port list
# EXCLUDE_PRINTERS_FROM_SECURITY_SCAN=true
# PRINTER_SAFE_MODE=true

# Rate limiter storage. REDIS_URL wins; REDIS_HOST/PORT/DB/PASSWORD are the piecewise alternative.
# Without a reachable Redis the limiter falls back to in-memory storage (fine for one process).
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_PASSWORD=

# Serve Bootstrap/Chart.js from a CDN instead of the bundled copies (services/cdn_manager.py)
# CDN_ENABLED=false
# CDN_DOMAIN=
# CDN_FALLBACK_ENABLED=true

# FLASK_ENV is honoured as a fallback for ENV (production|development)
# FLASK_ENV=production
